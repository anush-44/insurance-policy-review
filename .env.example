# ==============================================================================
# PolicyLens Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Implemented providers: gemini (requires a key) or mock (offline/testing)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite

# Optional: Alternative providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding & Reranker Configuration
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
EMBEDDING_DEVICE=cpu
RERANKER_ENABLED=false
RERANKER_CANDIDATE_POOL=30

# Vector Database (Qdrant)
# QDRANT_MODE: 'server' (Docker service at host:port) or 'local' (embedded disk storage)
QDRANT_MODE=local
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_LOCAL_PATH=./qdrant_storage

# Relational Storage (SQLite)
DATABASE_URL=sqlite+aiosqlite:///policylens.db

# Observability (Langfuse - Optional)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Application Settings
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
UI_PORT=8501
